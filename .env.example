# LLM-Lesung configuration. Copy to `.env` and fill in as needed.
# The web server needs none of these. Operator details (Impressum, contact
# address) live in data/operator.json, not here.

# Claude credentials — OPTIONAL. The analysis pipeline runs on the Claude Agent
# SDK, which authenticates like Claude Code: if you are logged in via
# `claude login` (claude.ai subscription), no key is needed here. Set
# ANTHROPIC_API_KEY only to bill against the Anthropic API instead, or
# CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`) for headless/container
# runs on a subscription.
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# DIP (Bundestag) API key — OPTIONAL. A working public, referer-locked key is
# built in as the default, so you only set this to use your own personal key
# (request one from parlamentsdokumentation@bundestag.de). The public key
# rotates ~yearly; if it stops working, re-scrape it from
# https://dip.bundestag.de/dip-config.js or set it here.
# DIP_API_KEY=SbGXhWA.3cpnNdb8rkht7iWpvSgTP8XIG88LoCrGd4

# Analysis model — OPTIONAL. Defaults to claude-sonnet-5-5.
# ANALYSIS_MODEL=claude-sonnet-5-5

# Reasoning effort of the analysis — OPTIONAL. low, medium, high, xhigh or max.
# Defaults to high.
# ANALYSIS_EFFORT=high

# Feed the existing law the draft amends or cites (selected by a cheap model
# call, fetched from gesetze-im-internet.de) after the draft — OPTIONAL. on or
# off, defaults to off. Switching it re-analyzes nothing by itself; run the
# pipeline with --force for that.
# BESTANDSRECHT_CONTEXT=off

# Model and effort of the call that selects that existing law — OPTIONAL.
# BESTANDSRECHT_MODEL=claude-haiku-5-5
# BESTANDSRECHT_EFFORT=low

# Model that transcribes a response the output schema rejected — OPTIONAL.
# Its result is checked verbatim against that response. Defaults to claude-sonnet-5-5.
# RESCUE_MODEL=claude-sonnet-5-5

# How many bills the pipeline analyzes in parallel — OPTIONAL. Defaults to 10.
# SQLite writes always stay serial on the main thread.
# PIPELINE_CONCURRENCY=10

# SQLite database path — OPTIONAL. Defaults to ./data/llm-lesung.db.
# LLM_LESUNG_DB=./data/llm-lesung.db

# Directory for cached Drucksache PDFs — OPTIONAL. Defaults to
# ./data/pdf-cache; set empty to disable the download cache.
# PDF_CACHE_DIR=./data/pdf-cache

# Cache of gesetze-im-internet.de downloads (list of laws, law zips, paragraph
# texts frozen per bill) — OPTIONAL. Defaults to ./data/gii.
# GII_DIR=./data/gii

# Operator details file — OPTIONAL. Defaults to ./data/operator.json; copy
# operator-example.json there and fill it in. All fields optional: name +
# address show the Impressum, email the contact links. `make deploy` /
# `make push-operator` copy it to the instance.
# OPERATOR_FILE=./data/operator.json

# Fundstücke file — OPTIONAL. Defaults to ./data/highlights.json; copy
# highlights-example.json there. The tab shows only while it has entries.
# `make deploy` / `make push-highlights` copy it to the instance.
# HIGHLIGHTS_FILE=./data/highlights.json

# --- Deployment (see docs/DEPLOYMENT.md) ------------------------------------
# Required for `make deploy` and friends; set here and nowhere else, no
# defaults. The app itself needs neither.

# Name of a profile in ~/.aws/credentials — not a key. Supplies the region too.
# AWS_PROFILE=

# Path to the private SSH key; <SSH_KEY>.pub must sit beside it and is uploaded
# as the EC2 key pair. Changing it after provisioning replaces the instance.
# SSH_KEY=~/.ssh/id_ed25519

# Cloudflare Tunnel token — OPTIONAL. When set, `make deploy` copies it to the
# instance and starts `cloudflared` beside the app, publishing the site under
# the hostname configured for that tunnel at Cloudflare. Unset: no tunnel, the
# site stays reachable only from your own IP.
# TUNNEL_TOKEN=
