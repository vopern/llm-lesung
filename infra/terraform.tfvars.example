# Copy to terraform.tfvars and fill in (or run `make infra-ip`). my_ip and my_ipv6 are required.
#
#   cp terraform.tfvars.example terraform.tfvars && make infra-ip

my_ip   = "203.0.113.4/32"    # your public IPv4
my_ipv6 = "2001:db8:1:2::/64" # your IPv6 /64 prefix

# Optional overrides (defaults shown):
# instance_type = "t3.micro"
# key_name      = "llm-lesung"

# aws_profile and ssh_public_key_path are required but not set here: they come
# from AWS_PROFILE and SSH_KEY in the project .env. Deploy with `make`; bare
# `terraform` prompts for them. The region comes from the AWS profile.
